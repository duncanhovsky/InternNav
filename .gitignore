# ============================================================
# InternNav .gitignore
# 目标：忽略所有训练/推理中间产物，只上传必要的源码和配置
# ============================================================

# ====================
# Python 通用
# ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.venv
venv/
ENV/
env.bak/
venv.bak/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ====================
# IDE / Editor
# ====================
.vscode/
.idea/
*.swp
*.swo
*~
*.py~
*.sh~

# macOS
.DS_Store

# ====================
# 模型权重 / Checkpoint 文件
# ====================
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.tflite
*.h5
*.pb

# ====================
# 训练输出目录
# ====================
# 训练产生的 checkpoint、TensorBoard、日志等全部在 checkpoints/ 下
checkpoints/

# 工作目录（mmlab 风格）
work_dirs/

# 训练/推理结果
result/
/results/
output/

# ====================
# 训练日志与监控
# ====================
# WandB
wandb/

# TensorBoard
*.tfevents*
events.out.tfevents.*

# 训练日志
logs/
*.log
*.log.json

# HuggingFace Trainer 产物
trainer_state.json
training_args.bin
runs/

# nohup / 后台运行
nohup.out

# ====================
# DeepSpeed 产物
# ====================
*.ds_model
global_step*/
latest

# ====================
# 数据集与大文件
# ====================
# 数据集目录（不上传原始数据）
data/
kujiale_data/
interiornav_data/

# LMDB 数据库文件
*.lmdb
*.mdb
lock.mdb

# pickle 中间文件
*.pkl
*.pkl.json

# Numpy 大文件（数据集中间产物）
*.npy
# 保留 iros_challenge 中的示例 captures
!scripts/iros_challenge/onsite_competition/captures/*.npy

# HDF5
*.hdf5

# 视频文件
*.mp4
*.avi
*.mov
*.mkv

# ====================
# 生成的图片文件
# ====================
# 训练/推理产生的可视化图片
*.png
*.jpg
*.jpeg
# 保留 iros_challenge 中的示例 captures 图片
!scripts/iros_challenge/onsite_competition/captures/*.png
!scripts/iros_challenge/onsite_competition/captures/*.jpg

# ====================
# 其他中间产物
# ====================
# Gradio 缓存
.gradio/

# 可视化调试
.vis_debug/

# PID 文件
*.pid

# pre-commit 缓存（不影响 .pre-commit-config.yaml）
pre-commit*

# Profiling
*.prof
*.pstats
*.trace

# test_data（实时推理调试数据）
test_data/

# Zarr 数据存储（Replay buffer 等）
*.zarr/

# ====================
# 项目特定
# ====================
# Sphinx documentation build
docs/en/_build/
docs/zh_cn/_build/

# mkdocs
/site

# 旧配置默认值
internutopia/default_config.py

# grutopia assets
/asset

# images 目录
images/

# LongCLIP 子模块（大模型文件）
internnav/model/basemodel/LongCLIP/

# dataengine 生成产物
dataengine/out/

# Django（历史遗留模板）
db.sqlite3
local_settings.py

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Celery
celerybeat-schedule

# SageMath
*.sage.py

# Rope project settings
.ropeproject

# Spyder
.spyderproject
.spyproject

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# PyBuilder
target/

# modelzoo 统计（自动生成）
docs/modelzoo_statistics.md
